# The runner loads apiKey and baseURL from this OpenCode config by default.
export OPENCODE_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/opencode/opencode.json"

# Both values select the same DeepSeek model through each runtime's naming scheme.
export DSH_MODEL="deepseek-v4-flash"
export OPENCLAW_MODEL="bench-proxy/deepseek-v4-flash"

# Optional explicit overrides; keep secrets out of tracked files.
# export BENCH_API_KEY=""
# export BENCH_BASE_URL="https://example.invalid/v1"
